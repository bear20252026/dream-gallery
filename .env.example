# 梦幻画廊配置模板：复制为 .env 后修改生效（.env 不会公开，注意别外传）
# 所有项都可留空/删除，留空即为关闭

# 端口号（默认 3000）
PORT=3000

# API 鉴权密码（公网模式用；白板保存需 whiteboard.html?token=同值）
TOKEN=

# CORS 允许源(生产默认 https://cloudbear.cloud;开发 localhost 由服务端自动放行 *）
# 如需额外域名: CORS_ORIGIN=https://your.site,https://other.site
# CORS_ORIGIN=*

# 管理 token 是否允许 URL query 传递(0=禁用公网 query,仅 x-token 头;本地开发仍可 query)
# TOKEN_QUERY=0

# CSP 是否恢复完整 unsafe-eval(默认关闭,使用 wasm-unsafe-eval;仅排查兼容问题时临时打开)
# CSP_UNSAFE_EVAL=1

# 问答门（设置后访客需答对才能进入）
GATE_QUESTION=你是谁？
GATE_HINT=风听从我的召唤
GATE_ANSWER=
