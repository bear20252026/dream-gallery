# 梦幻画廊配置模板：复制为 .env 后修改生效（.env 不会公开，注意别外传）
# 所有项都可留空/删除，留空即为关闭

# 端口号（默认 3000）
PORT=3000

# API 鉴权密码（公网模式用；白板保存需 whiteboard.html?token=同值）
TOKEN=

# CORS 允许源（默认仅允许 cloudbear.cloud；开发环境 localhost 自动放行）
# 如需额外域名: CORS_ORIGIN=https://your.site,https://other.site
# CORS_ORIGIN=*

# 问答门（设置后访客需答对才能进入）
GATE_QUESTION=你是谁？
GATE_HINT=风听从我的召唤
GATE_ANSWER=
