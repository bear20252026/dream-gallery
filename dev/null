  "\u62B1\u7740\u7CFB\u84DD\u6761\u7EB9\u9886\u7ED3\u7684\u6CF0\u8FEA\u718A\uFF0C\u8138\u988A\u8D34\u7740\u5C0F\u82B1\u8D34\u7EB8\uFF0C\u82B1\u5F71\u6447\u66F3\u91CC\u7B11\u610F\u8F6F\u8F6F\u7684\u3002",
  "\u7EA2\u683C\u6C99\u53D1\u4E0E\u8001\u5F0F\u7535\u89C6\u56F4\u51FA\u590D\u53E4\u5C0F\u5C4B\uFF0C\u767D\u88D9\u7EA2\u5F00\u886B\u7684\u5C11\u5973\u76D8\u817F\u800C\u5750\uFF0C\u53CC\u9EBB\u82B1\u8FAB\u4E0B\u6BD4\u51FA\u4FCF\u76AE\u7684\u8036\u3002",
  "\u8DEA\u5750\u5728\u4E66\u5806\u4E0E\u751C\u70B9\u4E4B\u95F4\uFF0C\u7EA2\u8272\u65CB\u8F6C\u7535\u8BDD\u542C\u7B52\u8D34\u5728\u8033\u8FB9\uFF0C\u4EFF\u4F5B\u6B63\u5728\u63A5\u901A\u4E00\u901A\u6765\u81EA\u65E7\u65F6\u5149\u7684\u7535\u8BDD\u3002",
  "\u9ED1\u53D1\u5982\u7011\uFF0C\u9B13\u8FB9\u522B\u7740\u534A\u900F\u660E\u82B1\u74E3\u53D1\u5939\uFF0C\u9F3B\u5C16\u505C\u7740\u4E00\u53EA\u5C0F\u8774\u8776\u8D34\u7EB8\uFF0C\u7C89\u88D9\u5C11\u5973\u9759\u9759\u671B\u5411\u955C\u5934\u3002",
  "\u7C89\u8272\u7EB1\u88D9\u5C11\u5973\u62B1\u819D\u5750\u5728\u73AB\u7470\u82B1\u68AF\u65C1\uFF0C\u8EAB\u540E\u662F\u4E00\u7247\u5F00\u6EE1\u7E41\u82B1\u7684\u5C71\u5761\uFF0C\u50CF\u8D70\u8FDB\u753B\u91CC\u7684\u5348\u540E\u3002",
  "\u7C89\u8272\u5C42\u53E0\u7EB1\u88D9\u7684\u5C11\u5973\u7ACB\u5728\u7F20\u82B1\u7684\u767D\u8272\u5C0F\u67F1\u4E0A\uFF0C\u624B\u4E3E\u4E00\u679D\u82B1\uFF0C\u80CC\u540E\u5C55\u5F00\u8584\u7EB1\u8776\u7FFC\uFF0C\u5B9B\u5982\u82B1\u7530\u7CBE\u7075\u3002",
  "\u767D\u8272\u86CB\u7CD5\u88D9\u914D\u7C89\u7EA2\u5916\u5957\u534A\u62AB\u5728\u80A9\uFF0C\u5934\u9876\u67B6\u7740\u5F69\u8272\u6D3E\u5BF9\u773C\u955C\uFF0C\u8138\u988A\u8D34\u7740\u4EAE\u6676\u6676\u8D34\u7EB8\uFF0C\u5BF9\u955C\u6BD4\u51FA\u4FCF\u76AE\u81EA\u62CD\u3002",
  "\u8BD5\u8863\u95F4\u955C\u524D\uFF0C\u767D\u8272\u5C42\u53E0\u957F\u88D9\u5782\u843D\u53CA\u5730\uFF0C\u7C89\u7EA2\u5916\u886B\u633D\u5728\u81C2\u5F2F\uFF0C\u5934\u9876\u5F69\u6846\u58A8\u955C\u6DFB\u4E86\u51E0\u5206\u4FCF\u76AE\u3002",
  "\u53CC\u9EBB\u82B1\u8FAB\u7CFB\u7740\u661F\u661F\u53D1\u5939\uFF0C\u7C73\u8272\u6D1B\u4E3D\u5854\u88D9\u914D\u94A9\u82B1\u53D1\u5E26\uFF0C\u5C11\u5973\u5728\u955C\u524D\u8F7B\u63D0\u8FAB\u68A2\uFF0C\u795E\u60C5\u5B89\u9759\u53C8\u8BA4\u771F\u3002",
  "\u7EA2\u9488\u7EC7\u5F00\u886B\u886C\u7740\u767D\u88D9\u7EA2\u4E1D\u5E26\uFF0C\u53CC\u8FAB\u4E0A\u7F00\u6EE1\u6A31\u6843\u8774\u8776\u7ED3\uFF0C\u816E\u7EA2\u5FAE\u91BA\uFF0C\u7B11\u5BB9\u50CF\u4E00\u9897\u751C\u751C\u7684\u7CD6\u3002",
  "\u6A31\u6843\u53D1\u9970\u5782\u5728\u4E4C\u9ED1\u53CC\u8FAB\u95F4\uFF0C\u767D\u88D9\u7EA2\u886B\u76F8\u6620\uFF0C\u5C11\u5973\u6D45\u7B11\u671B\u5411\u955C\u5934\uFF0C\u7709\u773C\u5F2F\u5F2F\uFF0C\u6E29\u67D4\u5F97\u521A\u597D\u3002",
  "\u955C\u4E2D\u6620\u51FA\u7EA2\u767D\u683C\u7EB9\u7684\u80CC\u5F71\uFF0C\u955C\u524D\u7684\u5C11\u5973\u53CC\u8FAB\u7CFB\u7740\u683C\u7EB9\u8774\u8776\u7ED3\u4E0E\u7EA2\u6A31\u6843\uFF0C\u7EA2\u6251\u6251\u7684\u8138\u988A\u7B11\u610F\u76C8\u76C8\u3002",
  "\u7EA2\u5F00\u886B\u767D\u88D9\u7684\u5C11\u5973\u5750\u5728\u683C\u7EB9\u6C99\u53D1\u4E0A\uFF0C\u53CC\u624B\u628A\u8349\u8393\u86CB\u7CD5\u4E3E\u8FC7\u5934\u9876\uFF0C\u8EAB\u65C1\u56F4\u7740\u6CF0\u8FEA\u718A\u4E0E\u751C\u70B9\uFF0C\u6696\u5149\u91CC\u50CF\u4E00\u573A\u5C0F\u5C0F\u7684\u751F\u65E5\u4F1A\u3002",
  "\u7EA2\u8272\u68D2\u7403\u5E3D\u4E0B\u7684\u5377\u53D1\u5C11\u5973\uFF0C\u5728\u7F8E\u5986\u5E97\u955C\u5B50\u524D\u4E3E\u8D77\u624B\u673A\u81EA\u62CD\uFF0C\u7EA2\u683C\u767E\u8936\u88D9\u914D\u767D\u8272\u957F\u889C\uFF0C\u5143\u6C14\u6EE1\u6EE1\u3002",
  "\u767D\u8272\u82B1\u8FB9\u5E3D\u4E0B\uFF0C\u5979\u8138\u988A\u8D34\u7740\u5C0F\u82B1\u4E0E\u8774\u8776\u7ED3\u8D34\u7EB8\uFF0C\u6D45\u8272\u857E\u4E1D\u88D9\u8F7B\u88F9\uFF0C\u6307\u5C16\u62B5\u5728\u80F8\u524D\uFF0C\u73AB\u7470\u4E0E\u7EB1\u5E18\u7EC7\u6210\u6E29\u67D4\u80CC\u666F\u3002",
  "\u84EC\u84EC\u7684\u5976\u6CB9\u8272\u82B1\u8FB9\u5E3D\uFF0C\u9F50\u5218\u6D77\u4E0B\u8138\u988A\u7F00\u7740\u82B1\u74E3\u4E0E\u4E1D\u5E26\u8D34\u7EB8\uFF0C\u5979\u6258\u816E\u8F7B\u7B11\uFF0C\u50CF\u4ECE\u7AE5\u8BDD\u91CC\u63A2\u51FA\u5934\u3002",
  "\u7EA2\u767D\u63D2\u80A9\u8896\u77ED\u4E0A\u8863\u914D\u7EA2\u683C\u88D9\uFF0C\u7EA2\u8272\u7A7A\u9876\u5E3D\u4E0B\u7684\u5C11\u5973\u62B1\u7740\u6A44\u6984\u7403\uFF0C\u7AD9\u5728\u6A59\u8272\u5899\u524D\uFF0C\u4FCF\u76AE\u53C8\u98D2\u723D\u3002",
  "\u9F50\u8033\u77ED\u53D1\u7684\u5C11\u5973\u7AD9\u5728\u8377\u5858\u95F4\uFF0C\u767DT\u6064\u4E0A\u5370\u7740\u5C0F\u56FE\u6848\uFF0C\u4E00\u6735\u7C89\u8377\u5F00\u5728\u5979\u80A9\u65C1\uFF0C\u590F\u65E5\u6E05\u5E7D\u3002",
  "\u6EE1\u6C60\u8377\u53F6\u8FDE\u5929\u78A7\uFF0C\u7C89\u8377\u542B\u82DE\uFF0C\u8001\u5C4B\u9759\u5367\u5C71\u811A\uFF0C\u4E91\u5F71\u4F4E\u5782\uFF0C\u50CF\u4E00\u5E45\u70DF\u96E8\u5C71\u6751\u7684\u957F\u5377\u3002",
  "\u9752\u82D4\u56F4\u8D77\u4E00\u53E3\u77F3\u4E95\uFF0C\u6C34\u9762\u8361\u5F00\u5708\u5708\u6D9F\u6F2A\uFF0C\u5929\u5149\u788E\u5728\u6CE2\u7EB9\u91CC\uFF0C\u5B89\u9759\u5F97\u80FD\u542C\u89C1\u6C34\u6EF4\u58F0\u3002",
  "\u96E8\u4E1D\u659C\u843D\u8001\u6728\u697C\uFF0C\u5C42\u5C42\u98DE\u6A90\u4E0A\u7EA2\u706F\u7B3C\u8F7B\u6643\uFF0C\u82D4\u75D5\u722C\u4E0A\u74E6\u5F53\uFF0C\u65E7\u65F6\u5149\u5728\u96E8\u91CC\u53D1\u4EAE\u3002",
  "\u84DD\u8272\u9488\u7EC7\u5F00\u886B\u534A\u892A\u80A9\u5934\uFF0C\u5979\u8DEA\u5750\u5728\u788E\u82B1\u5E03\u4E0A\u4E3E\u8D77\u84DD\u8272\u6CE1\u6CE1\u673A\uFF0C\u53D1\u95F4\u522B\u6EE1\u5F69\u8272\u53D1\u5939\uFF0C\u5154\u5B50\u73A9\u5076\u4E0E\u6BDB\u7EBF\u56E2\u966A\u4F34\u5728\u4FA7\u3002",
  "\u7C89\u8272\u7EB1\u88D9\u7684\u5C11\u5973\u5750\u5728\u82B1\u95F4\u6728\u6905\u4E0A\uFF0C\u8EAB\u540E\u5C55\u5F00\u5DE8\u5927\u7684\u7C89\u767D\u8776\u7FFC\uFF0C\u624B\u91CC\u8F7B\u63E1\u4E00\u652F\u5C0F\u82B1\uFF0C\u50CF\u7AE5\u8BDD\u91CC\u7684\u82B1\u95F4\u7CBE\u7075\u3002",
  "\u793C\u5802\u91CC\u7684\u5408\u5F71\u65F6\u5149\uFF0C\u5979\u53CC\u624B\u6258\u816E\u6D45\u7B11\uFF0C\u8EAB\u65C1\u540C\u5B66\u6324\u8FDB\u955C\u5934\uFF0C\u84DD\u8272\u6821\u670D\u91CC\u85CF\u7740\u4E94\u6708\u7684\u9752\u6625\u3002",
  "\u5979\u76D8\u817F\u5750\u5728\u788E\u82B1\u5730\u6BEF\u4E0A\uFF0C\u6000\u91CC\u62B1\u7740\u4E00\u53EA\u767D\u5154\u73A9\u5076\uFF0C\u53D1\u95F4\u522B\u7740\u5C0F\u718A\u53D1\u5939\uFF0C\u8EAB\u65C1\u662F\u6C14\u7403\u4E0E\u6BDB\u7EBF\u56E2\uFF0C\u6E29\u67D4\u5F97\u50CF\u4E00\u573A\u5348\u540E\u68A6\u3002",
  "\u4EF0\u5934\u671B\u53BB\uFF0C\u6D53\u5BC6\u7684\u6811\u51A0\u4EA4\u7EC7\u6210\u7EFF\u8272\u7684\u7A79\u9876\uFF0C\u9633\u5149\u4ECE\u53F6\u9699\u95F4\u6F0F\u4E0B\uFF0C\u5929\u7A7A\u88AB\u679D\u53F6\u88C1\u6210\u7EC6\u788E\u7684\u84DD\u3002",
  "\u8001\u5F0F\u6728\u5C4B\u7684\u5929\u4E95\u91CC\uFF0C\u7EA2\u706F\u7B3C\u5782\u5728\u6A90\u4E0B\uFF0C\u6C34\u7F38\u4E0E\u76C6\u683D\u9519\u843D\u6446\u653E\uFF0C\u9752\u82D4\u722C\u6EE1\u77F3\u677F\uFF0C\u5C81\u6708\u5B89\u9759\u5F97\u80FD\u542C\u89C1\u547C\u5438\u3002",
  "\u8377\u5858\u8FDE\u7EF5\u5230\u8FDC\u5C71\u811A\u4E0B\uFF0C\u767D\u8377\u521D\u7EFD\uFF0C\u7C89\u82DE\u4EAD\u4EAD\uFF0C\u5C42\u53E0\u7684\u8377\u53F6\u95F4\u85CF\u7740\u4E00\u6574\u4E2A\u76DB\u590F\u7684\u6E05\u51C9\u3002",
  "\u7C2A\u82B1\u6EE1\u5934\u7684\u5973\u5B50\u659C\u501A\u5728\u7EA2\u5B57\u706F\u7B3C\u65C1\uFF0C\u91D1\u8272\u62AB\u80A9\u7F00\u6EE1\u4EAE\u7247\uFF0C\u7B11\u610F\u6E29\u5A49\uFF0C\u53E4\u97F5\u4E0E\u660E\u8273\u5728\u5979\u8EAB\u4E0A\u76F8\u9047\u3002",
  "\u7C89\u88D9\u5C11\u5973\u4E0E\u8776\u7FFC\u7ACB\u5728\u82B1\u6D77\u5E03\u666F\u524D\uFF0C\u5377\u53D1\u5782\u80A9\uFF0C\u53D1\u95F4\u522B\u7740\u95EA\u4EAE\u53D1\u9970\uFF0C\u76EE\u5149\u5B89\u9759\u5730\u671B\u5411\u955C\u5934\uFF0C\u5982\u68A6\u4F3C\u5E7B\u3002",
  "\u8F66\u53A2\u91CC\u7684\u81EA\u62CD\uFF0C\u957F\u53D1\u5782\u843D\u80A9\u5934\uFF0C\u84DD\u767D\u6821\u670D\u886C\u7740\u6D45\u6D45\u7B11\u610F\uFF0C\u6625\u672B\u4E94\u6708\u7684\u98CE\u4EFF\u4F5B\u4E5F\u8DDF\u7740\u5B89\u9759\u4E0B\u6765\u3002",
  "\u6444\u5F71\u68DA\u7684\u805A\u5149\u706F\u659C\u659C\u6D12\u4E0B\uFF0C\u6DF1\u7EFF\u8272\u62B9\u80F8\u957F\u88D9\u7684\u5C11\u5973\u624B\u6301\u5F13\u7BAD\u7ACB\u5728\u5149\u67F1\u65C1\uFF0C\u53D1\u95F4\u94F6\u9970\u95EA\u70C1\uFF0C\u82F1\u6C14\u53C8\u6E29\u67D4\u3002",
  "\u8BD5\u8863\u955C\u524D\uFF0C\u5979\u80CC\u7740\u7BAD\u56CA\u4E3E\u8D77\u624B\u673A\u81EA\u62CD\uFF0C\u58A8\u7EFF\u957F\u88D9\u914D\u68D5\u8272\u957F\u9774\uFF0C\u9ED1\u8272\u5377\u53D1\u5782\u843D\u80A9\u5934\uFF0C\u50CF\u4ECE\u7AE5\u8BDD\u91CC\u8D70\u51FA\u7684\u5973\u730E\u624B\u3002",
  "\u9ED1\u8272\u7F8A\u6BDB\u5377\u95F4\u522B\u7740\u94F6\u8272\u6D41\u82CF\u53D1\u5939\uFF0C\u7EA2\u6655\u67D3\u4E0A\u773C\u89D2\u4E0E\u8138\u988A\uFF0C\u5979\u5BF9\u7740\u955C\u5934\u6D45\u6D45\u4E00\u7B11\uFF0C\u660E\u5A9A\u5F97\u6070\u5230\u597D\u5904\u3002",
  "\u7C2A\u82B1\u5C11\u5973\u7ACB\u5728\u4E66\u6CD5\u7EB1\u5E18\u4E0E\u7AF9\u5E18\u4E4B\u95F4\uFF0C\u7C89\u8272\u659C\u80A9\u7EB1\u88D9\u6620\u7740\u6696\u9EC4\u706F\u7B3C\u7684\u5149\uFF0C\u6307\u5C16\u8F7B\u633D\u5E18\u89D2\uFF0C\u6EE1\u773C\u6C5F\u5357\u8BD7\u610F\u3002",
  "\u5979\u6367\u7740\u76DB\u6EE1\u9C9C\u82B1\u7684\u7AF9\u76D8\u7AEF\u5750\u4E8E\u96D5\u82B1\u67DC\u524D\uFF0C\u8EAB\u540E\u7EA2\u5899\u4E0A\u300C\u87F3\u57D4\u300D\u4E8C\u5B57\u82CD\u52B2\uFF0C\u7AF9\u67B6\u82B1\u679D\u9519\u843D\uFF0C\u53E4\u97F5\u60A0\u7136\u3002",
  "\u77F3\u5899\u6591\u9A73\uFF0C\u7C2A\u82B1\u5C11\u5973\u63D0\u7740\u5C0F\u82B1\u7BEE\u5750\u5728\u77F3\u9636\u4E0A\u4FA7\u9996\u8FDC\u671B\uFF0C\u7C89\u7D2B\u82B1\u51A0\u4E0E\u7EB1\u88D9\u5728\u659C\u9633\u91CC\u6E29\u67D4\u53D1\u5149\u3002",
