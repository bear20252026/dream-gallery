var VERTICAL_PARAMS = {
  JUMP_V: 9.5,
  // 起跳初速
  FULL_GRAVITY: 26,
  // 常规重力
  GLIDE_GRAVITY: 3.5,
  // 滑翔重力(大幅减缓)
  GLIDE_MAX: 5,
  // 能量上限
  GLIDE_DRAIN: 0.35,
  // 滑翔耗能 /s
  GLIDE_REGEN: 1.2,
  // 落地回能 /s
  UPDRAFT_REGEN: 0.6,
  // 上升气流回能 /s
  VY_MIN: -12,
  // 下坠限速
  VY_MAX: 6,
  // 上升限速
  PITCH_DIVE: 6,
  // 抬头俯冲系数
  PITCH_LIFT: 1.5
  // 低头升力
};
