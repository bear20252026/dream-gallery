    y: state2.y,
    vy: state2.vy,
    onGround: state2.onGround,
    glideEnergy: state2.glideEnergy,
    gliding: false
  };
  if (s23.onGround && input.jumpPressed) {
    s23.vy = P2.JUMP_V;
    s23.onGround = false;
  }
  if (!s23.onGround && input.jumpHold && s23.glideEnergy > 0) {
    s23.gliding = true;
    s23.glideEnergy -= dt * P2.GLIDE_DRAIN;
    if (s23.glideEnergy < 0) s23.glideEnergy = 0;
  } else {
    s23.gliding = false;
    if (s23.onGround) s23.glideEnergy = Math.min(P2.GLIDE_MAX, s23.glideEnergy + dt * P2.GLIDE_REGEN);
  }
  s23.vy -= (s23.gliding ? P2.GLIDE_GRAVITY : P2.FULL_GRAVITY) * dt;
  if (s23.gliding) {
    if (input.pitch > 0.15) s23.vy -= input.pitch * P2.PITCH_DIVE * dt;
    if (input.pitch < -0.15) s23.vy += P2.PITCH_LIFT * dt;
    const ud = input.updraft || 0;
    if (ud > 0) {
      s23.vy += ud * dt;
      s23.glideEnergy = Math.min(P2.GLIDE_MAX, s23.glideEnergy + dt * P2.UPDRAFT_REGEN);
    }
    s23.vy = clamp2(s23.vy, P2.VY_MIN, P2.VY_MAX);
  }
  s23.y += s23.vy * dt;
  if (s23.y <= input.gy) {
    s23.y = input.gy;
    s23.vy = 0;
    s23.onGround = true;
  } else {
    s23.onGround = false;
  }
  return s23;
}

