{
  "name": "dream-gallery-backend",
  "version": "1.0.0",
  "description": "梦幻画廊静态托管 + 文件 API 后端",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/gen/check.js",
    "test": "node scripts/test/test.js && node scripts/test/test-mobile.js",
    "debug": "node scripts/probe/debug-browser.js",
    "dev": "node scripts/gen/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "gen:data": "node scripts/gen/gen-data.js",
    "gen:thumbs": "node scripts/gen/gen-thumbs.js",
    "postinstall": "node scripts/gen/sync-vendor.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.6",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "hls.js": "^1.6.16",
    "three": "0.160.0"
  }
