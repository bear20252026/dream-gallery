{
  "name": "dream-gallery-backend",
  "version": "1.0.0",
  "description": "梦幻画廊静态托管 + 文件 API 后端",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "npm run deps && npm run build && node scripts/test/test.js",
    "test": "node scripts/test/test-store.js && node scripts/test/test.js && node scripts/test/test-mobile.js",
    "debug": "node scripts/probe/debug-browser.js",
    "test:smoke": "node scripts/probe/smoke-gate.js",
    "test:orbit": "node scripts/probe/verify-orbit.js",
    "dev": "node scripts/gen/dev.js",
    "build": "vite build",
    "preview": "vite preview",
    "gen:data": "node scripts/gen/gen-data.js",
    "gen:thumbs": "node scripts/gen/gen-thumbs.js",
    "postinstall": "node scripts/gen/sync-vendor.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "optimize:images": "node scripts/optimize/optimize-textures.js",
    "optimize:images:dry": "node scripts/optimize/optimize-textures.js --dry-run",
    "optimize:models": "node scripts/optimize/optimize-models.js",
    "deps": "npx depcruise src --include-only \"^src\" --no-config --output-type err",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.css": [
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/three": "^0.185.4",
    "better-sqlite3": "^13.0.3",
    "dependency-cruiser": "^18.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-html": "^3.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "dotenv": "^17.4.2",
    "hls.js": "^1.6.16",
    "three": "0.160.0",
    "ws": "^8.18.0"
  }
}
